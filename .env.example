# ──────────────────────────────────────────────────────────────────────────────
# Sign2Voice — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10.0

# ── Gesture processing ────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
STABILITY_WINDOW=3
GESTURE_COOLDOWN=1.5

# ── TTS (gTTS) ────────────────────────────────────────────────────────────────
TTS_LANGUAGE=en
TTS_SLOW=false

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to true to enable scripted demo gestures (no live ML required)
DEMO_MODE=false
